mainmodule control {
    mainchare Main {
        entry Main(CkArgMsg* msg);
        entry void done(int value);
    };
    chare Worker {
        entry Worker(CProxy_Main p);
        entry void deliver(int tag, int value);
        entry void start() {
            serial { total = 0; }
            for (step = 0; step < 2; ++step) {
                when deliver[step](int tag, int value) serial {
                    total += value;
                }
            }
            if (total == 42) {
                serial { parent.done(total); }
            } else {
                serial { parent.done(-1); }
            }
        };
    };
};
