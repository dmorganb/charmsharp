{
  "name": "charmsharp",
  "displayName": "Charm# Language Support",
  "description": "Syntax highlighting and editing basics for Charm# (.csh)",
  "version": "0.1.0",
  "publisher": "dmorganb",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dmorganb/charmsharp"
  },
  "contributes": {
    "languages": [
      {
        "id": "charmsharp",
        "aliases": [
          "Charm#",
          "charmsharp"
        ],
        "extensions": [
          ".csh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "charmsharp",
        "scopeName": "source.charmsharp",
        "path": "./syntaxes/charmsharp.tmLanguage.json"
      }
    ]
  }
}
